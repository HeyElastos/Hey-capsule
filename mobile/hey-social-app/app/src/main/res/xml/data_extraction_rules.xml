<?xml version="1.0" encoding="utf-8"?>
<!-- Keep all on-device key material + data out of BOTH cloud backup and the
     Android 12+ device-to-device transfer channel. allowBackup=false already
     blocks cloud backup, but on targetSdk 31+ device-transfer must be excluded
     explicitly or it copies everything — including identity.json — to a new
     device. The whole `hey/` data dir (identity, encrypted storage tree, carrier
     state, audit log) and the app's SharedPreferences (the hardware-wrapped DEK
     ciphertext + tx history) are excluded from both channels. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="hey" />
        <exclude domain="sharedpref" path="hey.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="hey" />
        <exclude domain="sharedpref" path="hey.xml" />
    </device-transfer>
</data-extraction-rules>
