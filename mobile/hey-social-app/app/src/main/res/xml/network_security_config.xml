<?xml version="1.0" encoding="utf-8"?>
<!-- Internet-hidden posture for the ANDROID HTTP/WebView stack only. NOTE: the
     wallet JSON-RPC does NOT use this stack — it rides ureq → rustls with its own
     bundled webpki-roots CA set inside libhey_mobile_runtime.so, so this file does
     NOT govern (or protect) the wallet RPC. The wallet's own https-required gate
     lives in Rust (wallet.rs set_rpc_override / rpc_override, H6): a money/signing
     chain accepts cleartext http only for a loopback/RFC1918 node and flags it
     INSECURE. The carrier rides iroh/QUIC (also not the HTTP stack). This config
     denies cleartext + trusts ONLY the system CA store for any remaining Java/HTTP
     egress (a user-installed CA can't MITM it). No on-device loopback socket on
     Android, so no 127.0.0.1 exception is needed. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
