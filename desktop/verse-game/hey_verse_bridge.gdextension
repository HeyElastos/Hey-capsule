[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.2"
reloadable = true

[libraries]
linux.debug.x86_64 = "res://bin/libhey_verse_bridge.so"
linux.release.x86_64 = "res://bin/libhey_verse_bridge.so"
android.debug.arm64 = "res://bin/android/libhey_verse_bridge.so"
android.release.arm64 = "res://bin/android/libhey_verse_bridge.so"
