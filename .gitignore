client/dist
capsules/*/client/dist
# The Trunk capsules (hey-social, hey-chat) ship their PRE-BUILT bundle in the
# git tarball: runtime-ynh's deploy flattens the COMMITTED dist/* into the
# capsule root with NO on-server trunk build (_common.sh: "was dist/ left
# gitignored (it must be force-added)?"). So track the hashed wasm/js + the
# html/css, but keep build cruft (.stage, snippets, source maps) out.
capsules/*/dist/*
!capsules/*/dist/*.wasm
!capsules/*/dist/*.js
!capsules/*/dist/*.html
!capsules/*/dist/*.css
target
**/target
**/Cargo.lock.bak
.claude/
Hey.code-workspace
hey_ynh/

# ── build artifacts (regenerated by the build scripts) — NEVER commit ──
# gitignore has NO inline comments: each comment is on its own line.
.buildtmp/
.gradle/
**/.gradle/
# Gradle outputs (APKs, intermediates)
mobile/**/build/
# Godot import cache
mobile/**/.godot/
# per-machine SDK path
mobile/**/local.properties
# dev-only baked .glb previews
mobile/hey-verse/catalog_glb/
# BEAM source checkout + build tree + C++ deps
mobile/beam/.work/
mobile/beam/deps/

# ── monorepo-wide build junk (desktop/, JS, Tauri, Flatpak) ──
node_modules/
**/node_modules/
**/src-tauri/target/
.flatpak-builder/
**/.flatpak-builder/
*.AppImage
*.flatpak

# ── design/strategy docs — local only, never on git ──
docs/
*.code-workspace

# ── built APKs + regenerable native libs ──
*.apk
mobile/**/jniLibs/**/*.so
# Godot editor binary + downloaded tools (133 MB)
desktop/tools/
# Godot GDExtension bridge .so (regenerable from cargo, ~97 MB each)
**/bin/*.so
# verse.pck + godot-lib-slim.aar ARE kept so the APK builds without extra tooling.
